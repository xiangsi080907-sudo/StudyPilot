generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskType {
  ASSIGNMENT
  QUIZ
  EXAM
  PROJECT
  READING
  OTHER
}

enum SessionStatus {
  PLANNED
  COMPLETED
  SKIPPED
}

enum NotificationKind {
  DEADLINE
  EXAM
  MISSED_SESSION
  OVERLOAD
  PROGRESS
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accounts      Account[]
  sessions      Session[]
  courses       Course[]
  tasks         Task[]          @relation("TaskOwner")
  availability  Availability[]
  blockedTimes  BlockedTime[]
  studySessions StudySession[]
  notifications Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id            String         @id @default(cuid())
  userId        String
  name          String
  code          String
  professor     String?
  color         String         @default("#7567F8")
  icon          String         @default("book")
  /// GPA on a 0.0–4.0 scale. Legacy percentage values are converted by migration 20260913230000.
  currentGrade  Float?
  /// GPA on a 0.0–4.0 scale. Legacy percentage values are converted by migration 20260913230000.
  targetGrade   Float?
  priority      Int            @default(3)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         Task[]
  studySessions StudySession[]

  @@unique([userId, code])
  @@index([userId, priority])
}

model Task {
  id            String         @id @default(cuid())
  userId        String
  courseId      String
  title         String
  type          TaskType       @default(ASSIGNMENT)
  dueAt         DateTime
  estimatedMins Int
  difficulty    Int            @default(3)
  progress      Int            @default(0)
  priority      Int            @default(3)
  notes         String?        @db.Text
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation("TaskOwner", fields: [userId], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studySessions StudySession[]

  @@index([userId, dueAt])
  @@index([courseId, progress])
}

model Availability {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int
  startMins Int
  endMins   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

model BlockedTime {
  id        String   @id @default(cuid())
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
}

model StudySession {
  id          String        @id @default(cuid())
  userId      String
  courseId    String
  taskId      String?
  startsAt    DateTime
  endsAt      DateTime
  activity    String
  rationale   String?
  status      SessionStatus @default(PLANNED)
  actualMins  Int?
  planVersion String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  task        Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@index([taskId, startsAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
