# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studypilot?schema=public"

# Auth.js secrets. Generate a unique value before deployment.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional. StudyPilot uses the deterministic scheduler without this key.
OPENAI_API_KEY=""
